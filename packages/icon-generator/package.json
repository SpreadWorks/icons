{
  "name": "@spreadworks/icon-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Generate provider-neutral TypeScript icon modules.",
  "type": "module",
  "bin": {
    "icon-generator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "lucide-static": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/**/*.test.ts",
    "generate": "node dist/cli.js"
  }
}
